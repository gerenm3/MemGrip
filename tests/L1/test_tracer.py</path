    @pytest.mark.asyncio
    async def test_TC20_12___mask_messages不修改非system_role(self):
        """TC-20-12: _mask_messages - 不修改非 system role"""
        from core.tracer import Tracer
        messages = [
            {"role": "system", "content": "S"},
            {"role": "user", "content": "U"},
            {"role": "assistant", "content": "A"}
        ]
        result = Tracer._mask_messages(messages)
        # user/assistant role 的 content 不變
        assert result[1]["content"] == "U"
        assert result[2]["content"] == "A"